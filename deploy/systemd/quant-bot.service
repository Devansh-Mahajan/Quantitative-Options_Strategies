[Unit]
Description=QuantAlpha Trading Bot (automation controller)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__DIR__

EnvironmentFile=-__DIR__/.env
Environment=PYTHONUNBUFFERED=1

ExecStart=__PYTHON__ -m scripts.automation_controller --restart-on-failure

Restart=always
RestartSec=15
StartLimitIntervalSec=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=quant-bot

LimitNOFILE=65536
MemoryMax=2G

[Install]
WantedBy=multi-user.target
