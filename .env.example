# ============================================================
#  Quant Trading Bot — Environment Configuration
#  Copy this file to .env and fill in your values
# ============================================================

# ============================================================
# BROKER SELECTION  ← THE MAIN SWITCH
# Set to "binance" for live crypto trading.
# Set to "alpaca"  to paper-trade on Alpaca while you wait
#                  for Binance access / want to test logic.
# ============================================================
BROKER=alpaca                     # alpaca | binance

# ============================================================
# Alpaca credentials (used when BROKER=alpaca)
# Get your keys from: https://app.alpaca.markets/paper-trading
# ============================================================
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here
ALPACA_PAPER=true                 # true = paper trading (recommended to start)

# ============================================================
# Binance credentials (used when BROKER=binance)
# Get your keys from: https://www.binance.com/en/my/settings/api-management
# ============================================================
BINANCE_API_KEY=your_binance_key_here
BINANCE_API_SECRET=your_binance_secret_here
BINANCE_TESTNET=false             # true = Binance Testnet (safe paper mode)

# --- Capital & Risk Controls ---
INITIAL_CAPITAL=10000             # Starting capital (USD on Alpaca, USDT on Binance)
MAX_RISK_PER_TRADE=0.02           # 2% of account per single trade
MAX_PORTFOLIO_RISK=0.20           # Max 20% total account at risk
DAILY_LOSS_LIMIT=0.05             # Auto-halt if daily P&L < -5%
MAX_DRAWDOWN=0.15                 # Auto-halt if drawdown exceeds 15%
MAX_LEVERAGE=10                   # Max futures leverage (Binance only; ignored on Alpaca)
KELLY_FRACTION=0.25               # Fraction of Kelly criterion (0.25 = quarter-Kelly)

# --- Market Enablement ---
ENABLE_SPOT=true
ENABLE_FUTURES=true               # USDM perpetuals (Binance) or simulated via spot (Alpaca)
ENABLE_OPTIONS=false              # Binance EAPI options (Binance only; disabled on Alpaca)
ENABLE_COINM=false                # Coin-margined futures (Binance only)

# --- Strategy Toggles ---
# Note: funding_arb and basis_trade require futures — they silently produce no signals on Alpaca.
# Venue gating: gamma_scalping, vol_surface_arb, market_making, carry_portfolio and
# liquidation_cascade are AUTO-DISABLED on Alpaca regardless of these flags (they need
# futures/options venues or Binance-only data feeds); they re-enable on BROKER=binance.
ENABLE_MOMENTUM=true
ENABLE_MEAN_REVERSION=true
ENABLE_FUNDING_ARB=true           # No-op on Alpaca (no perpetual funding rates)
ENABLE_BASIS_TRADE=true           # No-op on Alpaca (no spot-futures basis)
ENABLE_PAIRS_ARB=true
ENABLE_OPTIONS_VOL=false          # Requires ENABLE_OPTIONS=true (Binance only)
ENABLE_ORDER_FLOW=true
ENABLE_BREAKOUT=true
ENABLE_STATISTICAL_ARB=true
ENABLE_CROSS_SECTIONAL_MOMENTUM=true
ENABLE_LIQUIDATION_CASCADE=true
ENABLE_CARRY_PORTFOLIO=true
ENABLE_TSMOM=true
ENABLE_QUANT_FACTORS=true
ENABLE_CONTRARIAN_OI=true
ENABLE_RMA_STRATEGY=true
ENABLE_VPIN_FLOW=true
ENABLE_KNN_PREDICTOR=true
ENABLE_PIVOT_SR=true
ENABLE_HP_TREND=true
ENABLE_MOMENTUM_CARRY_COMBO=true
ENABLE_MICROSTRUCTURE_PRESSURE=true
ENABLE_PULLBACK_CONFLUENCE=true

# --- Symbol Universe ---
# On Alpaca, BTCUSDT is automatically mapped to BTC/USD internally.
FUTURES_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,ADAUSDT,XRPUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT
SPOT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
STOCK_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,META,GOOGL
OPTIONS_UNDERLYING=BTC,ETH
REGIME_ANCHOR_SYMBOL=SPY
BENCHMARK_SYMBOL=SPY

# --- ML Configuration ---
DEVICE=cuda                       # cuda (RTX 5090) or cpu
MODEL_DIR=./models/live
TRAINING_DIR=./models/training
RETRAIN_LOOKBACK_DAYS=90
LSTM_LOOKBACK=50
HMM_STATES=4
RL_TIMESTEPS=200000

# --- Execution Settings ---
ORDER_TIMEOUT_SECONDS=30
MAX_REPRICES=3
MAKER_ONLY=false
TWAP_SLICES=5
MIN_NOTIONAL=10.0

# --- Notifications ---
# Set to a full Discord webhook URL, including https://
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logging
